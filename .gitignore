# Минимальный .gitignore для ML/Airflow проекта

# Airflow / ML data (игнорируем содержимое, но не папки)
config/*
data/input/*
data/output/*
!data/input/.gitkeep
!data/output/.gitkeep
logs/*
models/*
plugins/*

!config/.gitkeep
!logs/.gitkeep
!models/.gitkeep
!plugins/.gitkeep

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.egg

# Виртуальные окружения
.env
.venv
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Системные файлы
.DS_Store
Thumbs.db

# Конфиденциальная информация
secrets.*
credentials.*
*.key
*.pem